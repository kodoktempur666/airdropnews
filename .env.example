# ========================================================
# AirdropNews.my.id Environment Variables Configuration
# ========================================================

# Google Analytics 4 Measurement ID
# Dapatkan ID ini dari Google Analytics Console (Admin > Data Streams > Web)
# Format: G-XXXXXXXXXX
# Jika dikosongkan, script Google Analytics tidak akan dimuat.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID
# Dapatkan ID ini dari akun Google AdSense Anda (Akun > Setelan > Informasi Akun)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Jika dikosongkan, slot iklan akan menampilkan placeholder Neo-Brutalism yang aman.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Google Search Console Verification
# Token verifikasi kepemilikan domain di Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
